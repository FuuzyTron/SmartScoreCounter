<h1>Настройки</h1>

<%= form_with model: @user, url: settings_path, method: :patch do |f| %>
  <div>
    <%= f.label :name, "Имя" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :target_points, "Цель (баллы)" %><br>
    <%= f.number_field :target_points, min: 0 %>
  </div>

  <div>
    <%= f.label :current_points, "Сейчас баллов" %><br>
    <%= f.number_field :current_points, min: 0 %>
  </div>

  <div>
    <%= f.label :semester_goal_lessons, "Хочу занятий в семестре" %><br>
    <%= f.number_field :semester_goal_lessons, min: 0 %>
  </div>

  <h3>Расписание</h3>
  <% selected = @user.schedule_days.pluck(:day_of_week) %>

  <label><%= check_box_tag "days[]", "monday",    selected.include?("monday") %> Понедельник</label><br>
  <label><%= check_box_tag "days[]", "tuesday",   selected.include?("tuesday") %> Вторник</label><br>
  <label><%= check_box_tag "days[]", "wednesday", selected.include?("wednesday") %> Среда</label><br>
  <label><%= check_box_tag "days[]", "thursday",  selected.include?("thursday") %> Четверг</label><br>
  <label><%= check_box_tag "days[]", "friday",    selected.include?("friday") %> Пятница</label><br>
  <label><%= check_box_tag "days[]", "saturday",  selected.include?("saturday") %> Суббота</label><br>
  <label><%= check_box_tag "days[]", "sunday",    selected.include?("sunday") %> Воскресенье</label><br>

  <div style="margin-top: 12px;">
    <%= f.submit "Сохранить" %>
  </div>
<% end %>
