<!DOCTYPE html>
<html lang="ru">
<head>
  <title>My Page</title>
  <style>
      * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
      }

      body {
          font-family: Arial, sans-serif;
          line-height: 1.6;
          display: flex;
          flex-direction: column;
          min-height: 100vh;
      }

      /* Top Section */
      .top-section {
          background-color: #4477AA;
          color: white;
          padding: 0;
          height: 100px;
      }

      .header-container {
          margin: 0 auto;
          padding: 0 15px;
          display: flex;
          justify-content: normal;
          align-items: center;
          height: 100%;
      }

      .top-section h1 {
          font-size: 1.5rem;
          text-align: left;
          margin: 0;
          font-weight: 500;
      }

      .logo {
          height: 95px;
          width: auto;
          filter: brightness(0) invert(1);
          margin-left: auto;
      }

      /* Delimiter Section */
      .delimiter-section {
          background-color: #f3f3f3;
          padding: 0 15px;
          height: 50px;
          display: flex;
          align-items: center;
      }

      /* Log Button Styles */
      .log-button {
          color: dimgray;
          font-size: 14px;
          line-height: 18px;
          padding-left: 5px;
          width: 180px;
          height: 30px;
          border-radius: 5px;
          border: 1px solid darkgrey;
          display: inline-block;
          background: #FFFFFF;
          cursor: pointer;
      }

      .log-button:hover {
          background: ghostwhite;
      }

      .log-button:active {
          box-shadow: 1px 2px 7px 4px rgba(68,119,170,0.38);
      }

      button.log-button {
          text-align: left;
      }

      /* Bottom Section */
      .bottom-section {
          background-color: #f3f3f3;
          padding: 20px 0;
          margin-top: auto;
      }
  </style>
</head>
<body>
<div class="top-section">
  <div class="header-container">
    <h1>Интерактивный подсчет баллов физкультуры ЮФУ</h1>
    <%= image_tag("logo.png", alt: "Logo", class: "logo") %>
  </div>
</div>

<div class="delimiter-section">
  <%= button_to 'Войти', "/login", method: :get, class: "log-button" %>
</div>

<div style="padding-left: 15px">
  <%= form_with model: @user, url: signup_path do |f| %>
    <div>
      <%= f.label :name, "Имя" %><br>
      <%= f.text_field :name %>
    </div>

    <div>
      <%= f.label :login, "Ник" %><br>
      <%= f.text_field :login %>
    </div>

    <div>
      <%= f.label :password, "Пароль" %><br>
      <%= f.password_field :password %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Пароль ещё раз" %><br>
      <%= f.password_field :password_confirmation %>
    </div>

    <div style="padding-top: 15px">
      <%= f.submit "Создать аккаунт", class: "log-button"%>
    </div>
  <% end %>
</div>

<footer class="bottom-section">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; text-align: center;">
    <p>© 2025 Студенты ЮФУ. Все права не защищены.</p>
    <p>Контактная информация: группа ФИИТ 3-2</p>
  </div>
</footer>
</body>
</html>