<!DOCTYPE html>
<html lang="ru">
<head>
  <title>My Page</title>
  <style>
      * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
      }

      body {
          font-family: Arial, sans-serif;
          line-height: 1.4;
          display: flex;
          flex-direction: column;
          min-height: 100vh;
      }

      .top-section {
          background-color: #4477AA;
          color: white;
          padding: 0 0 0 0;
          height: 100px;
      }

      .header-container {
          margin: 0 auto;
          padding: 0 15px;
          display: flex;
          justify-content: normal;
      }

      .top-section h1 {
          font-size: 1.5rem;
          text-align: left;
          padding-top: 20px;
          padding-left: 0;
          margin: 0;
          font-weight: 500;
      }

      .logo {
          height: 95px;
          width: auto;
          filter: brightness(0) invert(1);
          margin-left: auto;
      }

      .delimiter-section {
          background-color: #f3f3f3;
          padding: 0 15px;
          height: 50px;
          display: flex;
          align-items: center;
      }

      .log-button {
          color: dimgray;
          font-size: 14px;
          line-height: 18px;
          padding-left: 5px;
          width: 180px;
          height: 30px;
          border-radius: 5px;
          border: 1px solid darkgrey;
          background: #FFFFFF;
          cursor: pointer;
          text-align: left;
      }

      .log-button:hover {
          background: ghostwhite;
      }

      .log-button:active {
          box-shadow: 1px 2px 7px 4px rgba(68,119,170,0.38);
      }

      .form-container {
          padding: 15px;
          display: flex;
          justify-content: center;
      }

      .form-container form {
          width: 100%;
          max-width: 400px;
      }

      .field {
          position: relative;
          margin-bottom: 22px;
      }

      .field label {
          display: block;
          margin-bottom: 4px;
          font-size: 14px;
      }

      .field input {
          display: block;
          width: 100%;
          padding: 8px;
          font-size: 14px;
          border: 1px solid #ccc;
          border-radius: 4px;
      }

      .error-message {
          position: absolute;
          left: 0;
          top: 100%;
          margin-top: 2px;
          font-size: 12px;
          line-height: 12px;
          color: red;
          max-width: 300px;
      }

      /* Footer */
      .bottom-section {
          background-color: #f3f3f3;
          padding: 20px 0;
          margin-top: auto;
      }
  </style>
</head>

<body>
<div class="top-section">
  <div class="header-container">
    <h1 style="margin-left: 0; padding-left: 0;">Интерактивный подсчет баллов физкультуры ЮФУ</h1>
    <%= image_tag("logo.png", alt: "Logo", class: "logo") %>
  </div>
</div>

<div class="delimiter-section">
  <%= button_to 'Регистрация', "/signup", method: :get, class: "log-button" %>
</div>

<div class="form-container">
  <%= form_with url: login_path do |f| %>

    <div class="field">
      <%= label_tag :login, "Ник" %>
      <%= text_field_tag :login, params[:login] %>

      <% if flash[:alert].present? %>
        <div class="error-message">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>

    <div class="field">
      <%= label_tag :password, "Пароль" %>
      <%= password_field_tag :password %>
    </div>

    <%= f.submit "Войти", class: "log-button" %>

  <% end %>
</div>

<footer class="bottom-section">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; text-align: center;">
    <p>© 2025 Студенты ЮФУ. Все права не защищены.</p>
    <p>Контактная информация: группа ФИИТ 3-2</p>
  </div>
</footer>
</body>
</html>
