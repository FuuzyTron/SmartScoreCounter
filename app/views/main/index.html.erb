<!DOCTYPE html>
<html lang="ru">
<head>
  <title>My Page</title>
  <style>
      * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
      }

      body {
          font-family: Arial, sans-serif;
          line-height: 1.6;
          display: flex;
          flex-direction: column;
          min-height: 100vh;
      }

      .top-section {
          background-color: #4477AA;
          color: white;
          padding: 0 0 0 0;
          height: 100px;
      }

      .header-container {
          margin: 0 auto;
          padding: 0 15px;
          display: flex;
          justify-content: normal;
      }

      .top-section h1 {
          font-size: 1.5rem;
          text-align: left;
          padding-top: 20px;
          padding-left: 0;
          margin: 0;
          font-weight: 500;
      }

      .logo {
          height: 95px;
          width: auto;
          filter: brightness(0) invert(1);
          margin-left: auto;
      }

      .delimiter-section {
          background-color: #f3f3f3;
          padding-left: 15px;
          height: 50px;
          display: flex;
          align-items: center;
      }

      .log-button {
          color: dimgray;
          font-size: 14px;
          padding-left: 5px;
          width: 180px;
          height: 30px;
          align-self: auto;
          border-radius: 5px;
          border: 1px solid darkgrey;
          display: inline-block;
          background: #FFFFFF;
      }

      .log-button:hover {
          background: ghostwhite;
      }

      .log-button:active {
          box-shadow: 1px 2px 7px 4px rgba(68, 119, 170, 0.38)
      }

      button.log-button {
          text-align: left;
      }

      .content {
          max-width: 1200px;
          margin: 40px auto;
          padding: 0 20px;
          flex: 1;
          display: grid;
          grid-template-columns: 2fr 1fr;
          gap: 40px;
      }

      .left-panel {
          display: flex;
          flex-direction: column;
          gap: 30px;
      }

      .right-panel {
          padding: 25px;
          height: fit-content;
      }

      .slider-container {
          width: 100%;
      }

      .slider {
          width: 200px;
      }

      .bottom-section {
          background-color: #f3f3f3;
          padding: 20px 0;
          margin-top: auto;
      }

      .radio-group {
          margin: 15px 0;
      }

      .radio-option {
          margin: 8px 0;
          display: flex;
          align-items: center;
      }

      .radio-option input[type="radio"] {
          margin-right: 10px;
      }

      .settings-container {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 40px;
          margin-bottom: 30px;
      }

      .goal-slider-container {
          display: flex;
          flex-direction: column;
          gap: 10px;
      }

      .slider-value {
          font-weight: bold;
          color: #4477AA;
          font-size: 18px;
          text-align: center;
          margin-top: 10px;
      }

      .slider-wrapper {
          display: flex;
          align-items: center;
          gap: 15px;
          margin-top: 10px;
      }

      .slider-labels {
          display: flex;
          justify-content: space-between;
          margin-top: 5px;
          font-size: 12px;
          color: #666;
      }

      .current-points-display {
          text-align: center;
          margin-bottom: 25px;
      }

      .current-points-value {
          font-size: 48px;
          font-weight: bold;
          color: #4477AA;
          margin: 15px 0;
      }

      .points-buttons {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 15px;
          margin-top: 20px;
      }

      .points-button {
          padding: 12px 0;
          font-size: 16px;
          border: none;
          border-radius: 8px;
          cursor: pointer;
          color: white;
          background: #4477AA;
      }

      .points-button:hover {
          opacity: 0.9;
      }


      .calendar-container {
          margin-top: 30px;
      }

      .points-form {
          margin: 0;
      }

      .chosen-day {
          background-color: rgba(68, 119, 170, 0.15);
          border-radius: 6px;
          font-weight: bold;
          color: #4477AA;
      }

  </style>
</head>
<body>
<div class="top-section">
  <div class="header-container">
    <h1 style="margin-left: 0; padding-left: 0;">Интерактивный подсчет баллов физкультуры ЮФУ</h1>
    <%= image_tag("logo.png", alt: "Logo", class: "logo") %>
  </div>
</div>

<% if current_user %>
  <%= form_with model: current_user, url: settings_path, method: :patch, id: "main-form" do %>
  <% end %>

<% end %>

<div class="delimiter-section">
  <% if current_user %>
    <%= button_to 'Выход', "/logout", method: :delete, class: "log-button" %>
    <div style="display: flex;padding-left: 50px">
      Здравствуйте, <%= current_user.name %>, ваши дни:
      <% selected = current_user.schedule_days.pluck(:day_of_week) %>

      <label style="margin-left: 5px">
        <%= check_box_tag "days[]", "monday", selected.include?("monday"), form: "main-form" %> Пн
      </label>
      <label style="margin-left: 5px">
        <%= check_box_tag "days[]", "tuesday", selected.include?("tuesday"), form: "main-form" %> Вт
      </label>
      <label style="margin-left: 5px">
        <%= check_box_tag "days[]", "wednesday", selected.include?("wednesday"), form: "main-form" %> Ср
      </label>
      <label style="margin-left: 5px">
        <%= check_box_tag "days[]", "thursday", selected.include?("thursday"), form: "main-form" %> Чт
      </label>
      <label style="margin-left: 5px">
        <%= check_box_tag "days[]", "friday", selected.include?("friday"), form: "main-form" %> Пт
      </label>
    </div>
  <% else %>
    <%= button_to 'Вход', "/login", method: :get, class: "log-button" %>
  <% end %>
</div>

<div class="content">
  <div class="left-panel">
    <% if current_user %>
      <div class="settings-container">
        <div class="radio-group">
          <%= label_tag "user_target_points", "Цель (диапазон баллов)", style: "font-weight: bold; font-size: 16px;" %>
          <br>

          <% current_value = current_user.target_points.to_i %>
          <% selected_60 = current_value >= 60 && current_value <= 70 %>
          <% selected_71 = current_value >= 71 && current_value <= 84 %>
          <% selected_85 = current_value >= 85 && current_value <= 100 %>

          <div class="radio-option">
            <%= radio_button_tag "user[target_points]", 60, selected_60, form: "main-form" %>
            <%= label_tag "user_target_points_60", "60-70 баллов", style: "font-size: 14px;" %>
          </div>

          <div class="radio-option">
            <%= radio_button_tag "user[target_points]", 71, selected_71, form: "main-form" %>
            <%= label_tag "user_target_points_71", "71-84 баллов", style: "font-size: 14px;" %>
          </div>

          <div class="radio-option">
            <%= radio_button_tag "user[target_points]", 85, selected_85, form: "main-form" %>
            <%= label_tag "user_target_points_85", "85-100 баллов", style: "font-size: 14px;" %>
          </div>
        </div>

        <div class="goal-slider-container">
          <%= label_tag "user_semester_goal_lessons", "Хочу занятий в семестре", style: "font-weight: bold; font-size: 16px;" %>
          <br>

          <% current_lessons = current_user.semester_goal_lessons || 10 %>

          <div class="slider-wrapper">
            <input type="range"
                   id="semester_goal_slider"
                   name="user[semester_goal_lessons]"
                   min="3"
                   max="13"
                   value="<%= current_lessons %>"
                   class="slider"
                   form="main-form"
                   oninput="updateSliderValue(this.value); updatePointsStrategy(this.value)"
            >
          </div>


          <div id="sliderValue" class="slider-value"><%= current_lessons %> занятий</div>
        </div>
      </div>

      <div style="margin-top: 5px; text-align: center;">
        <button type="submit" form="main-form" style="padding: 12px; background: #4477AA; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;">
          Сохранить настройки
        </button>
      </div>
    <% end %>

    <div class="calendar-container">
      <%= month_calendar do |date| %>
        <div style="text-align: center; padding: 5px;">
          <%= date.day %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="right-panel">
    <% if current_user %>
      <div class="current-points-display">
        <div class="current-points-label">Текущие баллы</div>
        <div class="current-points-value">
          <%= current_user.current_points %>
        </div>

        <% if current_user && @points_strategy && @points_strategy[:possible] %>
          <div style="margin-top: 20px; text-align: center; font-size: 14px;">
            Вы наберёте <%= @points_strategy[:total_points] %> баллов
            при выбранных днях, посетив
            <b><%= @points_strategy[:attend_term1] %></b> занятий в первом семестре
            и <b><%= @points_strategy[:attend_term2] %></b> занятий во втором семестре.
          </div>
        <% elsif current_user && @points_strategy %>
          <div style="margin-top: 20px; text-align: center; font-size: 14px; color: #a00;">
            При выбранных днях максимальный возможный результат —
            <%= @points_strategy[:max_points] %> баллов. Этого недостаточно
            для выбранного диапазона.
          </div>
        <% end %>


        <div class="points-buttons">
          <%= form_with url: update_current_points_path, method: :patch, class: "points-form" do |f| %>
            <%= hidden_field_tag :delta, -3 %>
            <%= submit_tag "-3 балла", class: "points-button minus minus-3" %>
          <% end %>

          <%= form_with url: update_current_points_path, method: :patch, class: "points-form" do |f| %>
            <%= hidden_field_tag :delta, 3 %>
            <%= submit_tag "+3 балла", class: "points-button plus plus-3" %>
          <% end %>

          <%= form_with url: update_current_points_path, method: :patch, class: "points-form" do |f| %>
            <%= hidden_field_tag :delta, -4 %>
            <%= submit_tag "-4 балла", class: "points-button minus minus-4" %>
          <% end %>

          <%= form_with url: update_current_points_path, method: :patch, class: "points-form" do |f| %>
            <%= hidden_field_tag :delta, 4 %>
            <%= submit_tag "+4 балла", class: "points-button plus plus-4" %>
          <% end %>
        </div>

      </div>
    <% else %>
      <div style="text-align: center; padding: 40px 20px;">
        <p style="color: #666; margin-bottom: 20px;">Войдите в систему, чтобы отслеживать свои баллы</p>
        <%= button_to 'Войти', "/login", method: :get, class: "log-button", style: "width: 100%; text-align: center;" %>
      </div>
    <% end %>
  </div>
</div>
<script>
    function updateSliderValue(value) {
        document.querySelector('#sliderValue').textContent = value + ' занятий';
    }

    function updatePointsStrategy(lessons) {
        fetch('/main/calculate_strategy', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
            },
            body: JSON.stringify({
                semester_goal_lessons: parseInt(lessons),
                target_points: document.querySelector('input[name="user[target_points]"]:checked')?.value || 60
            })
        })
            .then(response => response.json())
            .then(data => {
                // Обновляем правую панель
                document.querySelector('.current-points-value').textContent = data.current_points;

                const strategyDiv = document.querySelector('.current-points-display div[style*="margin-top: 20px"]');
                if (data.possible) {
                    strategyDiv.innerHTML = `
                Вы наберёте <b>${data.total_points}</b> баллов
                при выбранных днях, посетив <b>${data.attend_term1}</b> занятий в первом семестре и
                <b>${data.attend_term2}</b> во втором семестре.
            `;
                    strategyDiv.style.color = '';
                } else {
                    strategyDiv.innerHTML = `
                При выбранных днях максимальный возможный результат —
                <b>${data.max_points}</b> баллов. Этого недостаточно для выбранного диапазона.
            `;
                    strategyDiv.style.color = '#a00';
                }
            });
    }

    // При загрузке
    document.addEventListener('DOMContentLoaded', function () {
        const slider = document.getElementById('semester_goal_slider');
        if (slider) {
            updateSliderValue(slider.value);
        }

        // Обновляем при смене radio
        document.querySelectorAll('input[name="user[target_points]"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const slider = document.getElementById('semester_goal_slider');
                if (slider) updatePointsStrategy(slider.value);
            });
        });
    });
</script>

</script>
<footer class="bottom-section">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px; text-align: center;">
    <p>© 2025 Студенты ЮФУ. Все права не защищены.</p>
    <p>Контактная информация: группа ФИИТ 3-2</p>
  </div>
</footer>
</body>
</html>
