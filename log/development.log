17:            Здравствуйте, <%= current_user.name %>, ваши дни:
18:            <% selected = current_user.schedule_days.pluck(:day_of_week) %>
19:    
20:            <label style="margin-left: 5px">
21:              <%= check_box_tag "days[]", "monday", selected.include?("monday"), form: "main-form" %> Пн
22:            </label>
23:            <label style="margin-left: 5px">
24:              <%= check_box_tag "days[]", "tuesday", selected.include?("tuesday"), form: "main-form" %> Вт
25:            </label>
26:            <label style="margin-left: 5px">
27:              <%= check_box_tag "days[]", "wednesday", selected.include?("wednesday"), form: "main-form" %> Ср
28:            </label>
29:            <label style="margin-left: 5px">
30:              <%= check_box_tag "days[]", "thursday", selected.include?("thursday"), form: "main-form" %> Чт
31:            </label>
32:            <label style="margin-left: 5px">
33:              <%= check_box_tag "days[]", "friday", selected.include?("friday"), form: "main-form" %> Пт
34:            </label>
35:          </div>
36:        </div>
37:    
38:        <div class="content">
39:          <div class="left-panel">
40:            <div class="settings-container">
41:              <div class="radio-group">
42:                <%= f.label :target_points,
43:                            "Цель (диапазон баллов)",
44:                            style: "font-weight: bold; font-size: 16px;" %><br>
45:    
46:                <% current_value = current_user.target_points.to_i %>
47:                <% selected_60 = current_value >= 60 && current_value <= 70 %>
48:                <% selected_71 = current_value >= 71 && current_value <= 84 %>
49:                <% selected_85 = current_value >= 85 && current_value <= 100 %>
50:    
51:                <div class="radio-option">
52:                  <%= radio_button_tag "user[target_points]", 60, selected_60, form: "main-form" %>
53:                  <%= label_tag "user_target_points_60", "60-70 баллов", style: "font-size: 14px;" %>
54:                </div>
55:    
56:                <div class="radio-option">
57:                  <%= radio_button_tag "user[target_points]", 71, selected_71, form: "main-form" %>
58:                  <%= label_tag "user_target_points_71", "71-84 баллов", style: "font-size: 14px;" %>
59:                </div>
60:    
61:                <div class="radio-option">
62:                  <%= radio_button_tag "user[target_points]", 85, selected_85, form: "main-form" %>
63:                  <%= label_tag "user_target_points_85", "85-100 баллов", style: "font-size: 14px;" %>
64:                </div>
65:              </div>
66:    
67:              <div class="goal-slider-container">
68:                <%= f.label :semester_goal_lessons,
69:                            "Хочу занятий в семестре",
70:                            style: "font-weight: bold; font-size: 16px;" %><br>
71:    
72:                <% current_lessons = current_user.semester_goal_lessons || 10 %>
73:    
74:                <div class="slider-wrapper">
75:                  <%= f.range_field :semester_goal_lessons,
76:                                    min: 3,
77:                                    max: 13,
78:                                    value: current_lessons,
79:                                    id: "semester_goal_slider",
80:                                    class: "slider",
81:                                    oninput: "updateSliderValue(this.value)" %>
82:                </div>
83:    
84:                <div id="sliderValue"
85:                     class="slider-value"><%= current_lessons %> занятий</div>
86:              </div>
87:            </div>
88:    
89:            <div style="margin-top: 5px; text-align: center;">
90:              <button type="submit" style="padding: 12px; background: #4477AA; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer;">
91:                Сохранить настройки
92:              </button>
93:            </div>
94:    
95:            <div class="calendar-container">
96:              <%= month_calendar do |date| %>
97:                <div style="text-align: center; padding: 5px;">
98:                  <%= date.day %>
99:                </div>
100:              <% end %>
101:            </div>
102:          </div>
  
